{
  "manifest_version": 3,
  "name": "ClassPulse",
  "description": "Your Canvas command center.",
  "version": "2.0.0",
  "action": {
    "default_title": "ClassPulse",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs", "identity"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "oauth2": {
    "client_id": "CANVAS_CLIENT_ID_PLACEHOLDER",
    "scopes": []
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/courses/*/assignments/*",
        "http://localhost/courses/*/assignments/*",
        "http://127.0.0.1/courses/*/assignments/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
